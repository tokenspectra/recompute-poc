# Committed defaults. Override per machine in .a.env / .b.env (gitignored).
NEBIUS_PLATFORM="gpu-h100-sxm"
NEBIUS_PRESET="1gpu-16vcpu-200gb"
NEBIUS_IMAGE_FAMILY="ubuntu24.04-cuda13.0"
NEBIUS_IMAGE_PARENT="project-e00public-images"
NEBIUS_BOOT_DISK_GIB="150"
NEBIUS_BOOT_DISK_TYPE="network_ssd"
SSH_USER="user"
SSH_KEY_PUB="${HOME}/.ssh/id_ed25519.pub"
# vLLM v0.32.0, CUDA 13.0 index digest (research doc, read 2026-10-20). Same image on VM-A and VM-B.
VLLM_IMAGE="vllm/vllm-openai:v0.32.0@sha256:befccf0e7e4089aa23926bb6f887a85c0d46c2a99e6de5c5ffdf5cb7957c5b34"
MODEL_ID="Qwen/Qwen3-4B"
SERVED_MODEL_NAME="Qwen/Qwen3-4B"
DATA_DIR="/data"
